#!/usr/bin/python
# -*- mode: python; coding: utf-8 -*-

import sys
import os
import shutil
import argparse
from commodity.pattern import Bunch
from jinja2 import Environment, FileSystemLoader


class OpkgMaker:
    opkg_dir_path = "opkg"

    def __init__(self, args):
        self.args = args
        self.template_dir = self.get_template_dir()
        self.fill_control_fields()

    def run(self):
        self.build_opkg_dir()
        self.copy_templates()

    def build_opkg_dir(self):
        if os.path.exists(self.opkg_dir_path):
            if not self.args.force:
                print "Error, '{0}' directory exists, use -f to overwrite"\
                    .format(self.opkg_dir_path)
                sys.exit(-1)
            shutil.rmtree(self.opkg_dir_path)

        os.mkdir(self.opkg_dir_path)

    def copy_templates(self):
        src = "control.in"
        dst = os.path.join(self.opkg_dir_path, "control")
        self.render_template(src, dst)

        for script in ["preinst", "postinst", "prerm", "postrm"]:
            src = os.path.join(self.template_dir, script + ".in")
            dst = os.path.join(self.opkg_dir_path, script + ".ex")
            shutil.copy(src, dst)

        if self.args.init:
            src = "init.in"
            dst = os.path.join(self.opkg_dir_path, "init")
            self.render_template(src, dst)

            src = os.path.join(self.opkg_dir_path, "postinst.ex")
            dst = os.path.join(self.opkg_dir_path, "postinst")
            print "SOURCE:", src, os.path.exists(src)
            self.render_template(src, dst)
            os.remove(src)

    def render_template(self, src, dst):
        dirname, filename = os.path.split(src)
        if not dirname:
            dirname = self.template_dir

        env = Environment(loader=FileSystemLoader(dirname))
        template = env.get_template(filename)
        with file(dst, "w") as dst:
            dst.write(template.render(self.fields))

    def get_template_dir(self):
        template_dir = None
        for path in ["opkg.in", "/usr/share/carambola/opkg.in"]:
            if os.path.exists(path):
                template_dir = path
                break

        if template_dir is None:
            print "Error, template dir not found"
            sys.exit(-1)

        return template_dir

    def fill_control_fields(self):
        self.fields = Bunch()
        name, version = self.args.package.split("_")
        self.fields["name"] = name
        self.fields["version"] = version


if __name__ == "__main__":
    args = argparse.ArgumentParser()
    args.add_argument('-p', required=True, metavar="name_version", dest="package",
                      help='Package name')
    args.add_argument('-i', action="store_true", dest="init",
                      help='Include init script')
    args.add_argument('-f', action="store_true", dest="force",
                      help='Overwrite and force creatin')
    args = args.parse_args()

    OpkgMaker(args).run()

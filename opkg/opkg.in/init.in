#!/bin/sh /etc/rc.common
# -*- mode: sh; coding: utf-8 -*-

START=99
PIDFILE=/var/run/{{ name }}.pid

start() {
    echo "Starting {{ name }}..."
    /usr/bin/{{ name }} &
    echo $! > $PIDFILE
}

stop() {
    if [ ! -f $PIDFILE ]; then
	echo "Service not running, nothing done on stop"
	return 0
    fi

    echo "Stoping {{ name }}..."
    kill -9 $(cat $PIDFILE) > /dev/null 2>&1
}
